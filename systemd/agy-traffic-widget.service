[Unit]
Description=Antigravity Agent Traffic Light Standalone Wayland Widget
After=agy-traffic.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m agy_traffic_light.widget --position top-right --margin-bar 4 --margin-side 280
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target default.target
