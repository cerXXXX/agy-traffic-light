[Unit]
Description=Antigravity Agent Traffic Light System Tray Applet
After=agy-traffic.service graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/admin/agy-traffic-light/agy_traffic_light/tray.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=graphical-session.target default.target
